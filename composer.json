{
    "name": "mazmorra/mazmorra",
    "description": "Catálogo y reservas de La Mazmorra del Roleo",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^11.0",
        "phpmailer/phpmailer": "^6.12"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php",
            "app/Services/shipping.php",
            "app/Services/localidades.php",
            "app/Services/agenda.php",
            "app/Services/game-requests.php",
            "app/Mail/reservation-notifications.php"
        ]
    }
}
